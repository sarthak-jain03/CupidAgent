# Groq API Configuration for CupidAgent Python Backend
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=gpt-oss-120b

# Frontend Environment Variables (set in Vercel project settings)
# URL of your deployed Python backend (e.g. Render, Railway, etc.)
VITE_BACKEND_URL=https://your-backend-app.onrender.com

# Backend Environment Variables (set in backend host)
# URL of your deployed Vercel frontend (for CORS security)
FRONTEND_URL=https://your-frontend-app.vercel.app

# Optional: Comma-separated CORS origins or *
CORS_ORIGINS=*
